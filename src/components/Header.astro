---
import HeaderLink from './HeaderLink.astro';
import { COMPANY_NAME } from '../consts';


---

<header class="site-header">
	<nav class="nav" aria-label="Primary">
		<div class="brand">
			<a href="#home" class="wordmark">{COMPANY_NAME}</a>
		</div>

		<button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open menu">
			<span class="hamburger" aria-hidden="true"></span>
		</button>

		<ul id="primary-navigation" class="nav-list" role="menubar">
			<li role="none"><HeaderLink href="#home" role="menuitem">Home</HeaderLink></li>
			<li role="none"><HeaderLink href="#about" role="menuitem">About</HeaderLink></li>
			<li role="none"><HeaderLink href="#property-spectrum" role="menuitem">Property Spectrum</HeaderLink></li>
			<li role="none"><HeaderLink href="#contact" role="menuitem">Contact</HeaderLink></li>
		</ul>
	</nav>
</header>

<style>
	:root {}
	.site-header {
		position: sticky;
		top: 0;
		background: white;
		border-bottom: 1px solid rgba(0,0,0,0.06);
		z-index: 60;
	}
	.nav {
		max-width: 72rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem;
	}
	.wordmark {
		font-weight: 700;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 1rem;
	}
	.nav-list {
		display: flex;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.nav-list a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		padding: 0.5rem 0.5rem;
		border-bottom: 3px solid transparent;
	}
	.nav-list a.active,
	.nav-list a[aria-current="true"] {
		border-bottom-color: var(--accent);
		font-weight: 700;
	}
	.nav-toggle {
		display: none;
		background: none;
		border: 0;
		padding: 0.5rem;
	}
	.hamburger {
		display: block;
		width: 1.5rem;
		height: 2px;
		background: rgb(var(--gray-dark));
		position: relative;
	}
	.hamburger::before,
	.hamburger::after {
		content: "";
		display: block;
		width: 1.5rem;
		height: 2px;
		background: rgb(var(--gray-dark));
		position: absolute;
		left: 0;
	}
	.hamburger::before { top: -6px; }
	.hamburger::after { top: 6px; }

	@media (max-width: 720px) {
		.nav-list { display: none; }
		.nav-toggle { display: block; }
		.nav-list.open { display: flex; flex-direction: column; background: white; position: absolute; right: 1rem; top: 3.5rem; padding: 1rem; box-shadow: 0 8px 24px rgba(0,0,0,0.08); border-radius: 0.5rem; }
	}
</style>

<!-- Inline script to manage mobile toggle and scroll-spy active state -->
<script type="module">
	const toggle = document.getElementById('nav-toggle');
	const navList = document.getElementById('primary-navigation');
	if (toggle && navList) {
		toggle.addEventListener('click', () => {
			const expanded = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!expanded));
			navList.classList.toggle('open');
			toggle.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
		});

		// Close on link click (mobile)
		navList.querySelectorAll('a').forEach((a) => {
			a.addEventListener('click', () => {
				navList.classList.remove('open');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.focus();
			});
		});

		// Close on Escape
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				navList.classList.remove('open');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.focus();
			}
		});
	}

	// Scroll-spy using IntersectionObserver
	const observerOptions = { root: null, rootMargin: '0px 0px -40% 0px', threshold: 0 };
	const links = Array.from(document.querySelectorAll('#primary-navigation a'));
	const sections = links.map((l) => document.getElementById(l.getAttribute('href').slice(1))).filter(Boolean);
	if ('IntersectionObserver' in window && sections.length) {
		const io = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				const id = entry.target.id;
				const link = document.querySelector(`#primary-navigation a[href='#${id}']`);
				if (link) {
					if (entry.isIntersecting) {
						links.forEach((ln) => ln.removeAttribute('aria-current'));
						link.setAttribute('aria-current', 'true');
					}
				}
			});
		}, observerOptions);
		sections.forEach((s) => io.observe(s));
	}
</script>
