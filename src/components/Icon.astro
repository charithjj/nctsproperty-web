---
// Lightweight inline icons for feature cards. All icons decorative (aria-hidden).
const { name } = Astro.props;
---

{name === 'portfolio' ? (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="6" width="20" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 10h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
) : name === 'loan' ? (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><rect x="6" y="6" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
) : name === 'projection' ? (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 18l4-6 4 4 4-10 4 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
) : name === 'snapshot' ? (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M5 20c2-4 6-6 11-6" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
) : name === 'ownership' ? (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2v6" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M6 22v-8a6 6 0 0 1 12 0v8" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
) : (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
)}

<style>
  .icon { width: 2rem; height: 2rem; color: rgb(var(--teal-dark)); }
</style>
