---
const today = new Date();
---
</footer>
<footer class="site-footer">
	<div class="container">
		<div class="meta">
			&copy; {today.getFullYear()} Noble Craft Trade Solutions
		</div>
		<div class="tagline">Software and services for property investors</div>
		<div class="contact">Contact: <a href="mailto:info@nctsproperty.com.au">info@nctsproperty.com.au</a></div>
		<nav class="footer-nav" aria-label="Footer">
			<a href="#home">Home</a>
			<a href="#about">About</a>
			<a href="#property-spectrum">Property Spectrum</a>
			<a href="#contact">Contact</a>
		</nav>
		<p class="disclaimer">General information only. Not financial, investment, tax or legal advice. Projections are illustrative and are not guaranteed.</p>
	</div>
</footer>

<style>
	.site-footer { padding: 2.5rem 1rem; background: linear-gradient(var(--gray-gradient)); color: rgb(var(--gray)); text-align: center; }
	.site-footer .container { max-width: 72rem; margin: 0 auto; }
	.site-footer .meta { font-weight: 700; }
	.site-footer .tagline { margin-top: 0.25rem; }
	.site-footer .contact { margin-top: 0.5rem; }
	.footer-nav { display: flex; gap: 1rem; justify-content: center; margin-top: 0.75rem; }
	.footer-nav a { color: inherit; text-decoration: none; }
	.disclaimer { margin-top: 1rem; color: rgb(var(--gray)); font-size: 0.9rem; }
</style>
</style>
