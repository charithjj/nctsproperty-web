---
// Decorative hero illustration for the marketing homepage.
// This SVG is intentionally decorative and must be hidden from assistive tech.
---
<svg class="hero-illustration" viewBox="0 0 800 600" aria-hidden="true" focusable="false">
	<defs>
		<linearGradient id="g1" x1="0" x2="1">
			<stop offset="0%" stop-color="#06a6a6" stop-opacity="0.12" />
			<stop offset="100%" stop-color="#0d2230" stop-opacity="0.08" />
		</linearGradient>
	</defs>
	<!-- simplified property silhouettes -->
	<rect x="20" y="320" width="180" height="140" rx="8" fill="#ffffff" stroke="#e6eef0" />
	<rect x="220" y="260" width="140" height="200" rx="8" fill="#f7ffff" stroke="#e6eef0" />
	<rect x="380" y="300" width="220" height="160" rx="8" fill="#ffffff" stroke="#e6eef0" />
	<!-- abstract chart shapes -->
	<path d="M40 260 L120 200 L200 240 L280 160 L360 200" fill="none" stroke="#06a6a6" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" opacity="0.95"/>
	<circle cx="120" cy="200" r="8" fill="#06a6a6" />
	<circle cx="280" cy="160" r="8" fill="#06a6a6" />
	<!-- subtle backdrop -->
	<rect x="480" y="60" width="260" height="120" rx="12" fill="url(#g1)" />
</svg>

<style>
  .hero-illustration { width: 100%; height: auto; max-width: 36rem; display: block; }
</style>
